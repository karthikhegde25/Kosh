<resources>
    <string name="img_tools_title">Image tools</string>
    <string name="img_tools_subtitle">Edit, convert and tidy pictures on your device. Nothing is uploaded.</string>
    <string name="img_convert">Convert</string>
    <string name="img_convert_desc">Change pictures to PNG, JPG, WEBP, BMP or ICO. Several at once.</string>
    <string name="img_compress">Compress</string>
    <string name="img_compress_desc">Make JPG or WEBP files smaller by quality or to a size you type.</string>
    <string name="img_resize">Resize</string>
    <string name="img_resize_desc">Set an exact size, scale by percent, or fit inside a box.</string>
    <string name="img_crop">Crop</string>
    <string name="img_crop_desc">Drag a box or type its position. Same area for a whole batch.</string>
    <string name="img_rotate">Rotate &amp; flip</string>
    <string name="img_rotate_desc">Turn pictures by 90°, 180° or 270° and mirror them.</string>
    <string name="img_color">Color</string>
    <string name="img_color_desc">Brightness, contrast, saturation, hue and exposure with a live preview.</string>
    <string name="img_filters">Filters</string>
    <string name="img_filters_desc">Grayscale, sepia, vintage, blur, sharpen and more.</string>
    <string name="img_borders">Borders &amp; padding</string>
    <string name="img_borders_desc">Add padding with a colour or gradient, and rounded outer corners.</string>
    <string name="img_rounded">Rounded corners</string>
    <string name="img_rounded_desc">Round the corners of pictures with transparent edges.</string>
    <string name="img_watermark">Watermark</string>
    <string name="img_watermark_desc">Write your own text on pictures, anywhere you like.</string>
    <string name="img_stamp">Stamp</string>
    <string name="img_stamp_desc">Place a logo or sticker over a picture.</string>
    <string name="img_social">Social presets</string>
    <string name="img_social_desc">Resize for Instagram, X and YouTube in one go.</string>
    <string name="img_palette">Palette</string>
    <string name="img_palette_desc">Find the main colours of a picture and copy their codes.</string>
    <string name="img_collage">Collage</string>
    <string name="img_collage_desc">Combine 2 to 4 pictures into one.</string>
    <string name="img_increase">Increase size</string>
    <string name="img_increase_desc">Make a JPG or PNG file bigger without changing how it looks.</string>
    <string name="img_strip">Strip metadata</string>
    <string name="img_strip_desc">Remove camera details, time and location from pictures.</string>
